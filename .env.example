# LLM config — routed through LiteLLM, so any LiteLLM-supported provider works.
# https://docs.litellm.ai/docs/providers

# LiteLLM model string. Default: gemini/gemini-flash-latest
# Examples: openai/gpt-5, anthropic/claude-sonnet-4-6, gemini/gemini-flash-latest
LLM_MODEL=gemini/gemini-flash-latest

# API key for the chosen provider.
LLM_API_KEY=

# Optional: custom endpoint for OpenAI-compatible providers.
# LLM_BASE_URL=

# Optional: backup model used only after the primary exhausts retries
# (rate-limit / auth / payment / server errors). Key+endpoint default to the
# primary's; override only if the fallback is a different provider.
# LLM_FALLBACK_MODEL=openai/gpt-5-mini
# LLM_FALLBACK_API_KEY=
# LLM_FALLBACK_BASE_URL=

# Optional: cheaper/faster model just for page content extraction.
# Defaults to the primary model when unset.
# LLM_EXTRACTION_MODEL=gemini/gemini-flash-lite-latest
# LLM_EXTRACTION_API_KEY=
# LLM_EXTRACTION_BASE_URL=

# Legacy fallback (still used by research/strategy generation, which is Gemini-only).
# Get your key at https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# ── Browser profile ─────────────────────────────────────────────────────────
# By default the agents use a dedicated Chrome profile and you log in once.
# Set USE_SYSTEM_CHROME=true to instead reuse your existing, already-logged-in
# Chrome (no separate login). Close all Chrome windows before running.
# USE_SYSTEM_CHROME=false
# CHROME_PROFILE_DIRECTORY=Default        # e.g. "Default", "Profile 1" (auto-detected if unset)
# CHROME_EXECUTABLE_PATH=                  # explicit Chrome binary (overrides auto-detection)
# CHROME_USER_DATA_DIR=                    # explicit user-data dir (overrides auto-detection)

# ── Optional: browser-use action timeouts (seconds) ─────────────────────────
# All TIMEOUT_* vars are read directly by browser-use — no code change needed.
# Uncomment and bump these if you hit timeouts on slow networks or heavy pages.
# Full list: https://docs.browser-use.com/customize/agent/all-parameters
# TIMEOUT_NavigateToUrlEvent=30.0       # page navigation (default 15)
# TIMEOUT_TypeTextEvent=120.0           # typing text, e.g. long posts (default 60)
# TIMEOUT_BrowserStateRequestEvent=60.0 # fetching DOM/page state (default 30)
# TIMEOUT_ScrollEvent=15.0              # scrolling (default 8)
# TIMEOUT_WaitEvent=60.0               # explicit wait actions (default 60)
